# VITE_API_URL=http://localhost:5001/api


# Base URL of the backend API.
# Leave as "/api" to use the Vite dev proxy (recommended for development).
VITE_API_URL=/api

# Optional: point the "Watch" page at your own embed provider.
# Use {malId} and {episode} as placeholders, e.g.
#   VITE_EMBED_URL_TEMPLATE=https://example.com/embed/{malId}/{episode}
# Leave empty to use trailers + official platform links only.
VITE_EMBED_URL_TEMPLATE=
